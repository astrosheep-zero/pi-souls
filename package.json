{
  "name": "@astrosheep/pi-souls",
  "version": "0.7.1",
  "description": "Session souls with model-specific defaults for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/astrosheep-zero/pi-souls.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "plugins/claude",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:claude": "node scripts/build-claude.mjs",
    "test:claude-runtime-wire": "node --experimental-strip-types test/claude-runtime-wire.ts",
    "pretest": "npm run build:claude",
    "prepack": "npm run build:claude",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:claude-wire": "node --experimental-strip-types --test test/claude-wire.ts test/claude-wire-tools.ts test/claude-runtime-wire.ts",
    "typecheck": "tsc --noEmit",
    "check:load": "pi --no-extensions -e ./src/index.ts --list-models __load_check__"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "liquidjs": "^10.30.0"
  }
}
